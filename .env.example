# Copy to .env and fill the three passwords before docker compose up --build.
DB_USERNAME=sinapse
# PostgreSQL bootstrap administrator; not supplied to the application container.
DB_ADMIN_PASSWORD=
# Restricted application role, created during initialization of a new volume.
DB_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=
# Local HTTP only. Use true behind HTTPS for a future deployment.
APP_COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=
